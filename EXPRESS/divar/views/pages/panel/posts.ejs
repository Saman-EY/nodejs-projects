<div class="row">
  <div class="d-flex align-items-stretch">
    <div class="card w-100">
      <div class="card-body p-4">
        <% if(success_message) { %>
        <div class="row">
          <p class="alert alert-success"><%=success_message %></p>
        </div>
        <% } %>
        <div class="d-flex align-items-center justify-content-between w-100 mb-4">
          <h5 class="card-title fw-semibold">آگهی های من</h5>
          <a href="/post/create" class="btn btn-info"> انتشار آگهی جدید </a>
        </div>
        <div class="table-responsive">
          <% if (count !== 0) { %>
          <table class="table text-nowrap mb-0 align-middle">
            <thead class="text-dark w-100 fs-4">
              <tr>
                <th class="border-bottom-0">
                  <h6 class="fw-semibold mb-0">شناسه</h6>
                </th>
                <th class="border-bottom-0">
                  <h6 class="fw-semibold mb-0">عنوان</h6>
                </th>
                <th class="border-bottom-0">
                  <h6 class="fw-semibold mb-0">توضیحات</h6>
                </th>
                <th class="border-bottom-0">
                  <h6 class="fw-semibold mb-0">تاریخ انتشار</h6>
                </th>
              </tr>
            </thead>
            <tbody>
              <% { posts.forEach(post => { %>
              <tr>
                <td><%=post._id %></td>
                <td><%=post.title %></td>
                <td><%=post.content %></td>
                <td><%=moment(post.createdAt).locale('fa').format('jDD jMMMM jYYYY') %></td>
                <td>
                  <a href="/post/delete/<%=post._id %>" class="btn btn-red mx-1"> حذف </a>
                  <a href="/post/<%=post._id%>" class="btn btn-primary"> مشاهده </a>
                </td>
              </tr>
              <% })} %>
            </tbody>
          </table>
          <% } else { %>
          <div>
            <p class="alert alert-danger w-100 text-center">هیچ آگهیی برای نمایش وجود ندارد</p>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
